# Every tunable for the cold-chain platform. Copy to .env to override.
# Nothing here is a secret: there are no API keys, no cloud services.

# --- infrastructure (host names change inside docker compose) ---
CC_MQTT_HOST=localhost
CC_MQTT_PORT=1883
CC_DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5434/coldchain
CC_REDIS_URL=redis://localhost:6379/0
CC_TIMESCALE_ENABLED=true
CC_CORS_ORIGINS=*

# --- simulator cadence (seconds between readings) ---
CC_READING_INTERVAL_S=3

# --- validation ---
CC_MIN_PLAUSIBLE_TEMP_C=-60
CC_MAX_PLAUSIBLE_TEMP_C=80
CC_MAX_CLOCK_SKEW_FUTURE_S=120
CC_MAX_CLOCK_SKEW_PAST_S=604800

# --- risk bands (baseline risk owned by Person 3 until Person 4 overrides) ---
CC_RISK_LOW_MAX=25
CC_RISK_MEDIUM_MAX=50
CC_RISK_HIGH_MAX=75

# --- incident rules ---
CC_GFORCE_SHOCK_THRESHOLD=1.0
CC_GFORCE_HARD_SHOCK=2.0
CC_DOOR_OPEN_INCIDENT_S=15
CC_TRAFFIC_SPEED_THRESHOLD=10
CC_AMBIENT_TEMP_C=38

# --- intelligence engine (Person 4) ---
# Runs the deterioration/risk/optimization model on live telemetry.
CC_INTELLIGENCE_ENABLED=true
CC_INTELLIGENCE_INTERVAL_S=5
CC_INTELLIGENCE_TELEMETRY_WINDOW=120

# --- LLM (System 2) explainer: cloud, OpenRouter ---
# Any OpenRouter model id. The API key is NOT CC_-prefixed; put the real key in
# .env as OPENROUTERAPIKEY=... and never commit it.
CC_LLM_MODEL=deepseek/deepseek-v4.1-flash
CC_LLM_BASE_URL=https://openrouter.ai/api/v1
CC_LLM_TIMEOUT_S=20
CC_LLM_MAX_TOKENS=512
# The LLM may only move a deterministic spoilage estimate by this much.
CC_LLM_PROBABILITY_BAND=0.35

# --- Laya (System 1) decision engine: local, optional ---
# Runs in the `laya` compose service (laya-serve) over POST /v1/systemone.
# It corroborates the deterministic decision; it never overrides it.
CC_LAYA_ENABLED=true
CC_LAYA_URL=http://localhost:8100
CC_LAYA_MODEL=router
CC_LAYA_TIMEOUT_S=20

# --- deterioration / anomaly / optimization tuning ---
CC_ACTIVATION_ENERGY_DEFAULT_J_MOL=80000
CC_ANOMALY_Z_THRESHOLD=2.5
CC_TRANSPORT_COST_PER_KM=4.5
CC_DELAY_COST_PER_MIN=2.0
CC_TRANSIT_LOSS_RATE_PER_MIN=0.0008
CC_AVERAGE_SPEED_KMH=45

# --- spoilage prior calibration (prototype, not certified food science) ---
# E50: thermal exposure in °C·min above the safe maximum at which ~63% of the
# batch is judged at risk. Weights must sum to 1.0.
CC_SPOILAGE_EXPOSURE_E50_CMIN=15.0
CC_SPOILAGE_BASE_WEIGHT=0.4
CC_SPOILAGE_EXPOSURE_WEIGHT=0.6

# Put your real key in .env (git-ignored), never here. Leave blank to use the
# offline heuristic explainer / template fallback instead of LAYLA.
OPENROUTERAPIKEY=
